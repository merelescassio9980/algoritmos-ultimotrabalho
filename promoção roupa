Algoritmo "promoçãoRoupas"

// Autor(a)    : Cássio Eduardo Mereles
// Data atual  : 09/09/2026
Var
      peca: caracter
      precoOrig, total: real
      cont: inteiro
     
Inicio

      para cont de 1 até 2 passo 1 faca

      escreva("Nome da peça: ")
      leia(peca)

      escreva("Valor da peça: ")
      leia(precoOrig)
      
      total<-precoOrig-(precoOrig*0.2)
      escreval("Preço total: R$",total)
      
      fimpara
Fimalgoritmo
